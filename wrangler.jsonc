{
	"main": "dist/_worker.js/index.js",
	"name": "save-data-web",
  "compatibility_date": "2025-11-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
    "enabled": true
  }
}